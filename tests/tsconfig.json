{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "../dist-types/tests",
    "tsBuildInfoFile": "../dist-types/tests/.tsbuildinfo",
    "types": ["node"],
    "composite": true,
    "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "@storycode/core": ["packages/core/src/index.ts"],
      "@storycode/storage/node-fs": ["packages/storage/src/node-fs.ts"],
      "@storycode/storage": ["packages/storage/src/index.ts"],
      "@storycode/validation": ["packages/validation/src/index.ts"],
      "@storycode/agent": ["packages/agent/src/index.ts"]
    }
  },
  "include": ["**/*.ts"],
  "references": [
    { "path": "../packages/core" },
    { "path": "../packages/storage" },
    { "path": "../packages/validation" },
    { "path": "../packages/agent" }
  ]
}
